# Supabase project settings (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between the Next.js app and api/fundamentals.py so the Python
# endpoint isn't an open Yahoo-scraping proxy. Generate any random string and set
# it identically in both the Next.js env and the Vercel function's env.
FUNDAMENTALS_INTERNAL_TOKEN=

# Optional. How long a cached ticker's fundamentals are considered fresh before
# being re-fetched from yfinance. Defaults to 30 if unset.
FUNDAMENTALS_CACHE_TTL_MINUTES=30

# Local dev only, used when running `vercel dev` (next dev alone does not serve
# api/*.py, so the Python function isn't reachable without vercel dev).
PYTHON_FUNDAMENTALS_BASE_URL=http://localhost:3000
